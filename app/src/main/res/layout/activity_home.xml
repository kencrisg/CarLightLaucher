<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel principal 1024x600 (mdpi: 1 dp = 1 px), inspirado en Android Auto.
  Columnas laterales IGUALES -> el mapa queda centrado en x=512 (Organic Maps centra ahí la posición).
    Izquierda: km/h · hora · Bluetooth      Centro: mapa en vivo (toda la altura)
    Derecha:   radio · cuadrícula de apps
  Las tarjetas de BT y radio se abren tocando en cualquier parte salvo su fila de controles.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/gap">

        <!-- ================= IZQUIERDA ================= -->
        <LinearLayout
            android:layout_width="@dimen/side_column"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Velocímetro -->
            <FrameLayout
                android:id="@+id/cardSpeed"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.95">

                <com.carlight.launcher.ui.SpeedGaugeView
                    android:id="@+id/speedGauge"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center" />

                <!-- Computadora de viaje (toque en la tarjeta: alterna con el velocímetro) -->
                <GridLayout
                    android:id="@+id/tripView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnCount="2"
                    android:paddingHorizontal="@dimen/inset"
                    android:paddingVertical="14dp"
                    android:rowCount="2"
                    android:visibility="gone">

                    <LinearLayout style="@style/TripCell">
                        <TextView android:id="@+id/tripDistance" style="@style/TripValue" />
                        <TextView style="@style/TripLabel" android:text="@string/trip_distance" />
                    </LinearLayout>

                    <LinearLayout style="@style/TripCell">
                        <TextView android:id="@+id/tripTime" style="@style/TripValue" />
                        <TextView style="@style/TripLabel" android:text="@string/trip_time" />
                    </LinearLayout>

                    <LinearLayout style="@style/TripCell">
                        <TextView android:id="@+id/tripAvg" style="@style/TripValue" />
                        <TextView android:id="@+id/tripAvgLabel" style="@style/TripLabel" android:text="@string/trip_avg" />
                    </LinearLayout>

                    <LinearLayout style="@style/TripCell">
                        <TextView android:id="@+id/tripMax" style="@style/TripValue" />
                        <TextView android:id="@+id/tripMaxLabel" style="@style/TripLabel" android:text="@string/trip_max" />
                    </LinearLayout>
                </GridLayout>
            </FrameLayout>

            <!-- Hora (+ acceso a Ajustes) -->
            <FrameLayout
                android:id="@+id/cardClock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="0.7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/inset">

                <com.carlight.launcher.ui.fx.SkyBadgeView
                    android:id="@+id/skyBadge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/clockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp" />

                    <TextClock
                        android:id="@+id/clockDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:format12Hour="EEE d 'de' MMMM"
                        android:format24Hour="EEE d 'de' MMMM"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/openSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:alpha="0.6"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_title"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>

            <!-- Bluetooth: toda la tarjeta abre la app, salvo la fila de controles -->
            <LinearLayout
                android:id="@+id/cardBt"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="1.35"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/inset"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/SourceChip"
                        android:background="@drawable/bg_circle_music"
                        android:src="@drawable/ic_bluetooth" />

                    <TextView
                        style="@style/SourceLabel"
                        android:text="@string/bt_label" />

                    <com.carlight.launcher.ui.fx.EqBarsView
                        android:id="@+id/btEq"
                        android:layout_width="18dp"
                        android:layout_height="14dp"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/btDemo"
                        style="@style/DemoBadge" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="@dimen/inset"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 64 dp con resplandor: el disco visible empieza ~7 dp adentro → borde en 18 dp -->
                    <com.carlight.launcher.ui.fx.DiscView
                        android:id="@+id/btDisc"
                        android:layout_width="64dp"
                        android:layout_height="64dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btTitle"
                            style="@style/MediaTitle"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/btArtist"
                            style="@style/MediaSubtitle" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/btControls"
                    style="@style/ControlRow">

                    <ImageButton
                        android:id="@+id/btPrev"
                        style="@style/CtrlButton"
                        android:contentDescription="@string/cd_prev"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btPlay"
                        style="@style/PlayButton"
                        android:contentDescription="@string/cd_play_pause"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btNext"
                        style="@style/CtrlButton"
                        android:contentDescription="@string/cd_next"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= CENTRO: MAPA ================= -->
        <FrameLayout
            android:id="@+id/cardMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/gap"
            android:layout_weight="1"
            android:foreground="@drawable/bg_map_frame">

            <!-- Hueco: aquí se ve (y se toca) Organic Maps -->
            <FrameLayout
                android:id="@+id/mapHole"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/mapPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableTop="@drawable/ic_navigation_big"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:text="@string/nav_missing"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Próxima maniobra (notificación de Organic Maps) -->
            <LinearLayout
                android:id="@+id/mapManeuver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_maneuver"
                android:gravity="center_vertical"
                android:maxWidth="360dp"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/maneuverArrow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/glyph_map" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/maneuverDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFFFF"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/maneuverStreet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="260dp"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botones flotantes sobre el mapa (estilo Android Auto) -->
            <LinearLayout
                android:id="@+id/mapButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/mapFullscreen"
                    style="@style/MapFab"
                    android:contentDescription="@string/cd_map_fullscreen"
                    android:src="@drawable/ic_fullscreen" />

                <ImageButton
                    android:id="@+id/mapReload"
                    style="@style/MapFab"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/cd_map_reload"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>
        </FrameLayout>

        <!-- ================= DERECHA ================= -->
        <LinearLayout
            android:layout_width="@dimen/side_column"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Radio: toda la tarjeta abre la app, salvo la fila de controles -->
            <LinearLayout
                android:id="@+id/cardRadio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/inset"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/SourceChip"
                        android:background="@drawable/bg_circle_radio"
                        android:src="@drawable/ic_radio" />

                    <TextView
                        style="@style/SourceLabel"
                        android:text="@string/radio_label" />

                    <TextView
                        android:id="@+id/radioDemo"
                        style="@style/DemoBadge" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/inset"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/radioFreq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/radioUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/radio_unit"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/radioSub"
                    style="@style/MediaSubtitle"
                    android:layout_marginHorizontal="@dimen/inset" />

                <com.carlight.launcher.ui.fx.FreqDialView
                    android:id="@+id/radioDial"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="9dp"
                    android:layout_marginTop="6dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/radioControls"
                    style="@style/ControlRow">

                    <ImageButton
                        android:id="@+id/radioSeekDown"
                        style="@style/CtrlButton"
                        android:contentDescription="@string/cd_seek_down"
                        android:src="@drawable/ic_seek_down" />

                    <ImageButton
                        android:id="@+id/radioPrev"
                        style="@style/CtrlButtonTonal"
                        android:contentDescription="@string/cd_prev"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/radioNext"
                        style="@style/CtrlButtonTonal"
                        android:contentDescription="@string/cd_next"
                        android:src="@drawable/ic_next" />

                    <ImageButton
                        android:id="@+id/radioSeekUp"
                        style="@style/CtrlButton"
                        android:contentDescription="@string/cd_seek_up"
                        android:src="@drawable/ic_seek_up" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mi auto: kilometraje + recordatorios más urgentes (toque: abre Mi auto) -->
            <LinearLayout
                android:id="@+id/cardCar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/inset"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/SourceChip"
                        android:background="@drawable/bg_circle_car"
                        android:src="@drawable/glyph_car" />

                    <TextView
                        style="@style/SourceLabel"
                        android:text="@string/car_title" />

                    <TextView
                        android:id="@+id/carOdometer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/carList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Apps: una fila (3 accesos + "Apps") -->
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="@dimen/gap"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Cajón de apps (superpuesto) ===== -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_scrim"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/drawerSettings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/drawerClose"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <GridView
            android:id="@+id/drawerGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:columnWidth="118dp"
            android:numColumns="auto_fit"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp" />
    </LinearLayout>
</FrameLayout>
