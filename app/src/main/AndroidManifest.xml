<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Velocímetro por GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Volver a encender la ubicación del sistema si quedó apagada al arrancar
         (adb shell pm grant com.carlight.launcher android.permission.WRITE_SECURE_SETTINGS) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Brillo de día/noche (se concede con: adb shell appops set com.carlight.launcher WRITE_SETTINGS allow) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Prueba de micrófono -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Nombre del contacto en las llamadas (si la agenda del teléfono está sincronizada) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Recibir los broadcasts del stack Bluetooth (título/artista AVRCP) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <!-- Panel flotante sobre Organic Maps (mapa en vivo) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Frecuencia de la radio: la app de fábrica solo la registra en el log (se concede por adb) -->
    <uses-permission android:name="android.permission.READ_LOGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarLight">

        <activity
            android:name=".ui.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LAUNCHER permite abrirlo desde el launcher de fábrica para probar -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- "Mi auto" (mantenimiento y gasolina): misma pantalla que Ajustes, en modo auto -->
        <activity-alias
            android:name=".car.CarActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/car_title"
            android:targetActivity=".ui.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Prueba del micrófono de la radio -->
        <activity
            android:name=".tools.MicTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/mic_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Solo detecta qué app está al frente para ocultar/mostrar el panel flotante -->
        <service
            android:name=".overlay.ForegroundWatcher"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/foreground_watcher" />
        </service>

        <!-- Próxima maniobra de Organic Maps (lee su notificación de navegación) -->
        <service
            android:name=".nav.NavNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
